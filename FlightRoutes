#include <bits/stdc++.h>
using namespace std;

int n,ans;
string s;
bool d[755][755],t[755][755];

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(0);
	
    cin>>n;
    for(int i=1;i<n;i++)
    {
        cin>>s;
        for(int j=0;j<n-i;j++)
            t[i][i+j+1]=s[j]-'0';
    }
    for (int i=n-1;i>=1;i--)
    {
        for(int j=i+1;j<=n;j++)
        {
            int temp=t[i][j];
            for(int k=i+1;k<j;k++)
                temp^=d[i][k]*t[k][j];
            ans+=temp;
            d[i][j]=temp;
        }
    }
    cout<<ans;
    
    
	return 0;
}
