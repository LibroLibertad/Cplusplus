#include <bits/stdc++.h>
using namespace std;

long long n,q,z,y;
long long a[200005],l[200005],r[200005];

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(0);
	
    cin>>n;
    for(int i=1;i<=n;i++)
        cin>>a[i];
    sort(a+1,a+1+n);
    for(int i=2;i<=n;i++)
        l[i]=l[i-1]+(i-1)*(a[i]-a[i-1]);
    for (int i=n-1;i>=1;i--)
        r[i]=r[i+1]+(n-i)*(a[i+1]-a[i]);
    cin>>q;
    for (int i=1;i<=q;i++)
    {
        cin>>z>>y;
        int b=y*n/(z+y);
        if (b>0 && b<n)
            cout<<min(z*l[b]+y*r[b],z*l[b+1]+y*r[b+1])<<endl;
        else if (b==0)
            cout<<y*r[1]<<endl;
        else
            cout<<z*l[n]<<endl;
    }
    
    
	return 0;
}
